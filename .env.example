# Unique secret seeds -> deterministic agent addresses. CHANGE THESE.
CONCIERGE_SEED=change-me-concierge
SIGNAL_SEED=change-me-signal
RISK_SEED=change-me-risk
ACTION_SEED=change-me-action

# Optional: real RFQ email sending. If SMTP_HOST is unset, RFQs are written to ./outbox/ (dry-run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RFQ_FROM=procurement@example.com
# Route ALL demo RFQs to yourself instead of the (fake) supplier emails
RFQ_OVERRIDE_TO=

POLL_MINUTES=15
